<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Safe Land Tourism LLC</title>
  <meta name="description" content="Dubai tours, tickets, transport and unforgettable experiences.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
      background: #f7f9fc;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: #ffffff;
      border-bottom: 1px solid #e8edf5;
    }

    .nav {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      font-size: 20px;
      font-weight: 800;
      color: #0d2b52;
      white-space: nowrap;
    }

    .logo span {
      color: #d49a18;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }

    .nav-links a {
      font-weight: 600;
      font-size: 14px;
      color: #26354d;
    }

    .nav-links a:hover {
      color: #d49a18;
    }

    .nav-cta {
      background: #d49a18;
      color: #fff !important;
      padding: 10px 16px;
      border-radius: 8px;
    }

    .menu-btn {
      display: none;
      border: 0;
      background: none;
      font-size: 28px;
      cursor: pointer;
    }

    .hero {
      min-height: 570px;
      display: flex;
      align-items: center;
      position: relative;
      background-size: cover;
      background-position: center;
      background-image:
        linear-gradient(rgba(5, 18, 38, .62), rgba(5, 18, 38, .62)),
        url("assets/hero.jpg");
    }

    .hero-content {
      max-width: 720px;
      color: #fff;
      padding: 80px 0;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.3);
      padding: 8px 14px;
      border-radius: 50px;
      margin-bottom: 18px;
      font-size: 13px;
    }

    .hero h1 {
      font-size: clamp(40px, 6vw, 68px);
      line-height: 1.08;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 18px;
      max-width: 650px;
      margin-bottom: 30px;
      color: #eef3fa;
    }

    .hero-buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 20px;
      border-radius: 8px;
      font-weight: 700;
      border: 1px solid transparent;
    }

    .btn-primary {
      background: #d49a18;
      color: #fff;
    }

    .btn-secondary {
      background: #fff;
      color: #172033;
    }

    section {
      padding: 80px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-heading span {
      color: #d49a18;
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .section-heading h2 {
      font-size: 36px;
      margin-top: 7px;
      color: #0d2b52;
    }

    .section-heading p {
      max-width: 650px;
      margin: 10px auto 0;
      color: #68758a;
    }

    .service-groups {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .service-group {
      background: #fff;
      padding: 28px;
      border-radius: 14px;
      border: 1px solid #e8edf5;
    }

    .service-group h3 {
      color: #0d2b52;
      margin-bottom: 18px;
    }

    .service-group ul {
      list-style: none;
    }

    .service-group li {
      padding: 9px 0;
      border-bottom: 1px solid #edf0f5;
      color: #5f6c80;
    }

    .service-group li:last-child {
      border-bottom: 0;
    }

    .service-group li::before {
      content: "✓";
      color: #d49a18;
      font-weight: bold;
      margin-right: 9px;
    }

    .tour-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .tour-card {
      background: #fff;
      border-radius: 15px;
      overflow: hidden;
      border: 1px solid #e8edf5;
      box-shadow: 0 8px 25px rgba(20,40,70,.06);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .tour-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(20,40,70,.11);
    }

    .tour-image {
      height: 210px;
      width: 100%;
      object-fit: cover;
      background: #e8edf5;
    }

    .tour-content {
      padding: 22px;
    }

    .tour-category {
      color: #d49a18;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .8px;
    }

    .tour-card h3 {
      color: #0d2b52;
      margin: 7px 0 8px;
      font-size: 21px;
    }

    .tour-description {
      color: #68758a;
      font-size: 14px;
      min-height: 66px;
    }

    .tour-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 18px;
    }

    .price {
      color: #0d2b52;
      font-size: 21px;
      font-weight: 800;
    }

    .price small {
      display: block;
      color: #7b8799;
      font-size: 11px;
      font-weight: 500;
    }

    .tour-actions {
      display: flex;
      gap: 7px;
    }

    .small-btn {
      padding: 9px 11px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid #dfe5ee;
      background: #fff;
    }

    .book-btn {
      background: #138c4c;
      border-color: #138c4c;
      color: #fff;
    }

    .reviews {
      background: #fff;
    }

    .review-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .review-card {
      background: #f8fafc;
      border: 1px solid #e7ebf2;
      border-radius: 14px;
      padding: 25px;
    }

    .stars {
      color: #d49a18;
      letter-spacing: 2px;
      margin-bottom: 12px;
    }

    .review-text {
      color: #526075;
      margin-bottom: 18px;
    }

    .review-name {
      font-weight: 800;
      color: #0d2b52;
    }

    .review-location {
      color: #8a95a5;
      font-size: 13px;
    }

    .contact-box {
      background: #0d2b52;
      color: #fff;
      border-radius: 18px;
      padding: 55px;
      text-align: center;
    }

    .contact-box h2 {
      font-size: 35px;
      margin-bottom: 10px;
    }

    .contact-box p {
      color: #d8e1ef;
      margin-bottom: 25px;
    }

    footer {
      background: #081a31;
      color: #d8e1ef;
      padding: 45px 0 25px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 35px;
    }

    footer h3 {
      color: #fff;
      margin-bottom: 12px;
    }

    footer p,
    footer a {
      color: #aebbd0;
      font-size: 14px;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,.1);
      padding-top: 20px;
      text-align: center;
      color: #8795aa;
      font-size: 13px;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(4,12,25,.72);
      z-index: 2000;
      padding: 20px;
      align-items: center;
      justify-content: center;
    }

    .modal.show {
      display: flex;
    }

    .modal-box {
      width: min(650px, 100%);
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-image {
      width: 100%;
      height: 270px;
      object-fit: cover;
    }

    .modal-content {
      padding: 28px;
    }

    .modal-content h2 {
      color: #0d2b52;
      margin: 6px 0 12px;
    }

    .modal-content p {
      color: #637085;
      margin-bottom: 22px;
    }

    .close-modal {
      float: right;
      border: 0;
      background: #eef2f7;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 20px;
    }

    .loading,
    .error-message {
      grid-column: 1 / -1;
      text-align: center;
      padding: 30px;
      color: #68758a;
    }

    @media (max-width: 900px) {
      .tour-grid,
      .service-groups,
      .review-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 700px) {
      .menu-btn {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 72px;
        left: 0;
        right: 0;
        background: #fff;
        padding: 20px;
        flex-direction: column;
        align-items: stretch;
        border-bottom: 1px solid #e8edf5;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        display: block;
        padding: 8px;
      }

      .tour-grid,
      .service-groups,
      .review-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        min-height: 520px;
      }

      .hero h1 {
        font-size: 42px;
      }

      section {
        padding: 60px 0;
      }

      .contact-box {
        padding: 35px 22px;
      }

      .contact-box h2 {
        font-size: 28px;
      }

      .tour-bottom {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container nav">
    <a href="#" class="logo" id="brandLogo">SAFE LAND <span>TOURISM</span></a>

    <button class="menu-btn" id="menuBtn" aria-label="Open menu">☰</button>

    <ul class="nav-links" id="navLinks">
      <li><a href="#services">Services</a></li>
      <li><a href="#tours">Tours</a></li>
      <li><a href="#reviews">Reviews</a></li>
      <li><a href="#contact">Contact</a></li>
      <li>
        <a href="#" id="navWhatsApp" class="nav-cta">WhatsApp</a>
      </li>
    </ul>
  </div>
</header>

<main>

  <section class="hero" id="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge" id="heroLocation">DUBAI · UAE</div>
        <h1 id="heroTitle">Discover Dubai With Safe Land Tourism</h1>
        <p id="heroDescription">
          Dubai tours, tickets, transport and unforgettable experiences.
        </p>

        <div class="hero-buttons">
          <a href="#tours" class="btn btn-primary">Explore Tours</a>
          <a href="#" id="heroWhatsApp" class="btn btn-secondary">
            Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="container">
      <div class="section-heading">
        <span>What We Offer</span>
        <h2>Our Services</h2>
        <p>Everything you need for a smooth and memorable Dubai experience.</p>
      </div>

      <div class="service-groups" id="servicesGrid">
        <div class="loading">Loading services...</div>
      </div>
    </div>
  </section>

  <section id="tours">
    <div class="container">
      <div class="section-heading">
        <span>Explore Dubai</span>
        <h2>Featured Tours & Experiences</h2>
        <p>Choose your experience and book directly through WhatsApp.</p>
      </div>

      <div class="tour-grid" id="tourGrid">
        <div class="loading">Loading tours...</div>
      </div>
    </div>
  </section>

  <section class="reviews" id="reviews">
    <div class="container">
      <div class="section-heading">
        <span>Guest Experiences</span>
        <h2>What Our Customers Say</h2>
      </div>

      <div class="review-grid" id="reviewGrid">
        <div class="loading">Loading reviews...</div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <div class="contact-box">
        <h2>Ready to Explore Dubai?</h2>
        <p id="contactText">
          Contact us today and let us arrange your perfect Dubai experience.
        </p>

        <div class="hero-buttons" style="justify-content:center;">
          <a href="#" id="contactWhatsApp" class="btn btn-primary">
            WhatsApp Us
          </a>
          <a href="#" id="contactPhone" class="btn btn-secondary">
            Call Us
          </a>
        </div>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="container">

    <div class="footer-grid">

      <div>
        <h3 id="footerBrand">SAFE LAND TOURISM LLC</h3>
        <p id="footerLocation">DUBAI · UAE</p>
        <p style="margin-top:8px;">
          Tours, tickets, transport and unforgettable Dubai experiences.
        </p>
      </div>

      <div>
        <h3>Contact</h3>
        <p>
          <a href="#" id="footerPhone">+971 50 491 5900</a>
        </p>
        <p>
          <a href="#" id="footerEmail">info@safelandtourism.com</a>
        </p>
      </div>

      <div>
        <h3>Quick Links</h3>
        <p><a href="#services">Services</a></p>
        <p><a href="#tours">Tours</a></p>
        <p><a href="#reviews">Reviews</a></p>
        <p><a href="#contact">Contact</a></p>
      </div>

    </div>

    <div class="footer-bottom">
      © <span id="year"></span> <span id="copyrightBrand">SAFE LAND TOURISM LLC</span>.
      All rights reserved.
    </div>

  </div>
</footer>

<!-- Tour Modal -->
<div class="modal" id="tourModal">
  <div class="modal-box">

    <img id="modalImage" class="modal-image" src="" alt="Tour">

    <div class="modal-content">

      <button class="close-modal" id="closeModal">×</button>

      <div class="tour-category" id="modalCategory"></div>

      <h2 id="modalTitle"></h2>

      <p id="modalDescription"></p>

      <div class="tour-bottom">
        <div class="price">
          <span id="modalPrice"></span>
          <small id="modalNote"></small>
        </div>

        <a id="modalWhatsApp" href="#" class="btn book-btn">
          Book on WhatsApp
        </a>
      </div>

    </div>
  </div>
</div>

<script>
  const CONTENT_PATH = "content/";

  let allTours = [];

  /*
    GitHub Pages runs this website inside:
    /Safe-Land-Tourism/

    Pages CMS may save an image as:
    /assets/photo.jpg

    This function converts it into:
    assets/photo.jpg

    so it works correctly on the GitHub Pages subpath.
  */
  function sitePath(path) {
    if (!path) return "";

    if (/^https?:\/\//i.test(path)) {
      return path;
    }

    path = String(path).trim();

    while (path.startsWith("/")) {
      path = path.substring(1);
    }

    if (path.startsWith("Safe-Land-Tourism/")) {
      path = path.substring("Safe-Land-Tourism/".length);
    }

    return path;
  }

  async function loadJSON(file) {
    const response = await fetch(CONTENT_PATH + file);

    if (!response.ok) {
      throw new Error("Unable to load " + file);
    }

    return await response.json();
  }

  function escapeHTML(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function whatsappLink(number) {
    if (!number) return "#";

    if (String(number).startsWith("http")) {
      return number;
    }

    const clean = String(number).replace(/\D/g, "");

    return "https://wa.me/" + clean;
  }

  function phoneLink(phone) {
    if (!phone) return "#";

    const clean = String(phone).replace(/[^\d+]/g, "");

    return "tel:" + clean;
  }

  async function loadSite() {
    const site = await loadJSON("site.json");

    document.title = site.brand_name || "Safe Land Tourism";

    document.getElementById("brandLogo").innerHTML =
      escapeHTML(site.brand_name || "SAFE LAND TOURISM");

    document.getElementById("heroLocation").textContent =
      site.location || "DUBAI · UAE";

    document.getElementById("heroTitle").textContent =
      site.hero_title || "Discover Dubai";

    document.getElementById("heroDescription").textContent =
      site.hero_description || "";

    document.getElementById("hero").style.backgroundImage =
      `linear-gradient(rgba(5,18,38,.62), rgba(5,18,38,.62)), url("${sitePath(site.hero_image)}")`;

    const wa = whatsappLink(site.whatsapp);
    const phone = phoneLink(site.phone);

    document.getElementById("navWhatsApp").href = wa;
    document.getElementById("heroWhatsApp").href = wa;
    document.getElementById("contactWhatsApp").href = wa;
    document.getElementById("contactPhone").href = phone;

    document.getElementById("footerBrand").textContent =
      site.brand_name || "";

    document.getElementById("footerLocation").textContent =
      site.location || "";

    document.getElementById("footerPhone").textContent =
      site.phone || "";

    document.getElementById("footerPhone").href = phone;

    document.getElementById("footerEmail").textContent =
      site.email || "";

    document.getElementById("footerEmail").href =
      site.email ? "mailto:" + site.email : "#";

    document.getElementById("copyrightBrand").textContent =
      site.brand_name || "";

    document.getElementById("year").textContent =
      new Date().getFullYear();
  }

  async function loadServices() {
    const data = await loadJSON("services.json");
    const grid = document.getElementById("servicesGrid");

    grid.innerHTML = "";

    (data.groups || []).forEach(group => {
      const card = document.createElement("div");

      card.className = "service-group";

      card.innerHTML = `
        <h3>${escapeHTML(group.title)}</h3>
        <ul>
          ${(group.items || []).map(item =>
            `<li>${escapeHTML(item)}</li>`
          ).join("")}
        </ul>
      `;

      grid.appendChild(card);
    });
  }

  async function loadTours() {
    const data = await loadJSON("tours.json");

    allTours = data.tours || [];

    const grid = document.getElementById("tourGrid");

    grid.innerHTML = "";

    if (!allTours.length) {
      grid.innerHTML =
        `<div class="loading">No tours available.</div>`;
      return;
    }

    allTours.forEach((tour, index) => {

      const card = document.createElement("article");

      card.className = "tour-card";

      card.innerHTML = `
        <img
          class="tour-image"
          src="${escapeHTML(sitePath(tour.image))}"
          alt="${escapeHTML(tour.name)}"
          loading="lazy"
          onerror="this.style.display='none'"
        >

        <div class="tour-content">

          <div class="tour-category">
            ${escapeHTML(tour.category)}
          </div>

          <h3>
            ${escapeHTML(tour.name)}
          </h3>

          <p class="tour-description">
            ${escapeHTML(tour.description)}
          </p>

          <div class="tour-bottom">

            <div class="price">
              ${escapeHTML(tour.price)}
              <small>${escapeHTML(tour.note)}</small>
            </div>

            <div class="tour-actions">

              <button
                class="small-btn"
                onclick="openTour(${index})">
                Details
              </button>

              <a
                class="small-btn book-btn"
                href="${escapeHTML(whatsappLink(tour.whatsapp))}"
                target="_blank"
                rel="noopener">
                Book
              </a>

            </div>

          </div>

        </div>
      `;

      grid.appendChild(card);
    });
  }

  async function loadReviews() {
    const data = await loadJSON("reviews.json");

    const grid = document.getElementById("reviewGrid");

    grid.innerHTML = "";

    (data.reviews || []).forEach(review => {

      const rating = Math.max(
        0,
        Math.min(5, Number(review.rating) || 0)
      );

      const card = document.createElement("div");

      card.className = "review-card";

      card.innerHTML = `
        <div class="stars">
          ${"★".repeat(rating)}${"☆".repeat(5 - rating)}
        </div>

        <p class="review-text">
          “${escapeHTML(review.review)}”
        </p>

        <div class="review-name">
          ${escapeHTML(review.name)}
        </div>

        <div class="review-location">
          ${escapeHTML(review.location)}
        </div>
      `;

      grid.appendChild(card);
    });
  }

  function openTour(index) {
    const tour = allTours[index];

    if (!tour) return;

    document.getElementById("modalImage").src =
      sitePath(tour.image);

    document.getElementById("modalImage").alt =
      tour.name || "Tour";

    document.getElementById("modalCategory").textContent =
      tour.category || "";

    document.getElementById("modalTitle").textContent =
      tour.name || "";

    document.getElementById("modalDescription").textContent =
      tour.description || "";

    document.getElementById("modalPrice").textContent =
      tour.price || "";

    document.getElementById("modalNote").textContent =
      tour.note || "";

    document.getElementById("modalWhatsApp").href =
      whatsappLink(tour.whatsapp);

    document.getElementById("tourModal")
      .classList.add("show");
  }

  function closeTour() {
    document.getElementById("tourModal")
      .classList.remove("show");
  }

  document.getElementById("closeModal")
    .addEventListener("click", closeTour);

  document.getElementById("tourModal")
    .addEventListener("click", function(event) {
      if (event.target === this) {
        closeTour();
      }
    });

  document.getElementById("menuBtn")
    .addEventListener("click", function() {
      document.getElementById("navLinks")
        .classList.toggle("open");
    });

  document.querySelectorAll(".nav-links a")
    .forEach(link => {
      link.addEventListener("click", () => {
        document.getElementById("navLinks")
          .classList.remove("open");
      });
    });

  async function startSite() {
    try {
      await loadSite();
      await loadServices();
      await loadTours();
      await loadReviews();
    } catch (error) {
      console.error(error);

      document.getElementById("tourGrid").innerHTML =
        `<div class="error-message">
          Website content could not be loaded.
        </div>`;
    }
  }

  startSite();
</script>

</body>
</html>
